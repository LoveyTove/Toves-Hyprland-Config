{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/Artix.txt",
    "padding": {
      "top": 4
    },
    "color": {
    "1": "38;2;59;119;188",
    "2": "38;2;144;218;244",
    "3": "38;2;255;255;255"
  }
  },
  "display": {
    "separator": " ➤ ",
    "percent": {
      "color": {
        "green": "38;2;59;119;188",  
        "yellow": "38;2;34;68;107" 
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[30m⬤ \u001b[31m⬤ \u001b[32m⬤ \u001b[33m⬤ \u001b[34m⬤ \u001b[35m⬤ \u001b[36m⬤ \u001b[37m⬤ \u001b[0m"
    },
    {
      "type": "custom",
      "format": "{#38;2;255;255;255}┏━━━━━━━━━━━━━{#} Software {#38;2;255;255;255}━━━━━━━━━━━━━┓{#}"
    },
    {
      "type": "os",
      "key": "OS      ",
      "keyColor": "38;2;34;68;107",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "keyColor": "38;2;34;68;107",
      "key": "Kernel  "
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "38;2;59;119;188",
      "format": "{pacman} (Pacman)"
    },
    {
      "type": "wm",
      "key": "WM      ",
      "keyColor": "38;2;59;119;188",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "38;2;144;218;244",
      "format": "{pretty-name}"
    },

    {
      "type": "custom",
      "format": "{#38;2;255;255;255}┣━━━━━━━━━━━━━{#} Hardware {#38;2;255;255;255}━━━━━━━━━━━━━┫{#}"
    },
    {
      "type": "cpu",
      "key": "CPU     ",
      "keyColor": "38;2;144;218;244",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "GPU     ",
      "keyColor": "38;2;59;119;188",
      "format": "AMD Radeon HD 6350"
    },
    {
      "type": "memory",
      "key": "Memory  ",
      "keyColor": "38;2;59;119;188",
      "format": "{used} / {total} {#38;2;59;119;188}({#}{percentage}{#38;2;59;119;188}){#}",
      "percent": {
        "type": 9,
        "color": {
        "yellow": 0
        }
    }
    },
    {
      "type": "disk",
      "key": "Root    ",
      "keyColor": "38;2;34;68;107",
      "folders": "/",
      "format": "{size-used} / {size-total} {#38;2;34;68;107}({#}{size-percentage}{#38;2;34;68;107}){#}",
        "percent": {
        "type": 9,
        "green": 0
      }
    },
        {
      "type": "disk",
      "key": "Storage ",
      "keyColor": "38;2;34;68;107",
      "folders": "/Storage",
      "format": "{size-used} / {size-total} {#38;2;34;68;107}({#}{size-percentage}{#38;2;34;68;107}){#}",
      "percent": {
        "type": 9,
        "green": 0
      }
    },
    {
      "type": "custom",
      "format": "{#38;2;255;255;255}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛{#}"
    },
    {
      "type": "custom",
      "format": "\u001b[90m⬤ \u001b[91m⬤ \u001b[92m⬤ \u001b[93m⬤ \u001b[94m⬤ \u001b[95m⬤ \u001b[96m⬤ \u001b[97m⬤ \u001b[0m"
    }
  ]
}